# Make.com webhook that receives completed assessments.
#
# Server-only on purpose: this is read inside app/api/submit/route.ts and must
# NOT be prefixed with NEXT_PUBLIC_, or it ships in the browser bundle where
# anyone can scrape it and post junk straight into your sheet.

MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id

# Public base URL, used for canonical links and social card metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
