# Make.com webhook that receives completed assessments.
#
# Server-only on purpose: this is read inside app/api/submit/route.ts and must
# NOT be prefixed with NEXT_PUBLIC_, or it ships in the browser bundle where
# anyone can scrape it and post junk straight into your sheet.

MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id

# Public base URL, used for canonical links and social card metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Durable rate limiting (optional but strongly recommended in production).
#
# Without these the limiter falls back to an in-memory Map that is per-instance
# and resets on every cold start — fine locally, not a real limit on a public
# URL. Provision Upstash Redis from the Vercel Marketplace (free tier is
# enough) and it injects both of these automatically.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
